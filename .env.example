# --- Email (Gmail App Password required) ---
GMAIL_USER="your.email@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"

# --- OpenWeatherMap ---
WEATHER_API_KEY="your-api-key"

# --- NewsAPI ---
NEWS_API_KEY="your-api-key"

# --- WolframAlpha ---
WOLFRAM_APP_ID="your-app-id"

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID="your-account-sid"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_FROM_NUMBER="+1234567890"
TWILIO_TO_NUMBER="+1234567890"

# --- Google Calendar ---
GOOGLE_CALENDAR_CREDENTIALS_PATH="credentials.json"

# --- LLM (Local via Ollama) ---
LLM_ENABLED="true"
# Recommended models: llama3.1:8b, qwen2.5:7b, mistral:7b, phi4:14b
LLM_MODEL="llama3.1:8b"
LLM_API_URL="http://localhost:11434/api/chat"

# --- Conversation ---
CONVERSATION_TIMEOUT="8"

# --- Speech ---
STT_ENGINE="google"    # google or vosk (offline)
VOSK_MODEL_PATH=""     # leave empty to auto-download

TTS_ENGINE="piper"     # piper, espeak, or pyttsx3
PIPER_BIN_PATH=""      # path to piper binary (default: ~/.local/bin/piper)
PIPER_VOICE_PATH=""    # path to piper voice model (default: ~/.local/share/piper-tts/voices/en_US-lessac-medium.onnx)
NOTES_DIR=""           # directory for saved notes (default: ~/Documents/AssistantNotes)
WALLPAPER_DIR=""       # directory for wallpaper images (default: ~/Pictures/Wallpapers)
MUSIC_DIR=""           # music directory (default: ~/Music)
